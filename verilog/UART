module uart_tx(
    input clk,
    input start,
    input [7:0] data,
    output reg tx = 1,
    output reg busy = 0
);

parameter CLKS_PER_BIT = 100_000_000 / 9600;

reg [15:0] clk_cnt = 0;
reg [3:0] bit_index = 0;
reg [9:0] tx_shift;

always @(posedge clk) begin

    if (start && !busy) begin
        busy <= 1;
        tx_shift <= {1'b1, data, 1'b0};
        bit_index <= 0;
        clk_cnt <= 0;
    end

    else if (busy) begin
        if (clk_cnt < CLKS_PER_BIT-1) begin
            clk_cnt <= clk_cnt + 1;
        end else begin
            clk_cnt <= 0;
            tx <= tx_shift[bit_index];
            bit_index <= bit_index + 1;

            if (bit_index == 9) begin
                busy <= 0;
                tx <= 1;
            end
        end
    end
end

endmodule
